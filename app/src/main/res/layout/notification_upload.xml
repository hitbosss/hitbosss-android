<?xml version="1.0" encoding="utf-8"?>
<!-- Cuerpo de la notificación de subida de HIT (con DecoratedCustomViewStyle: la cabecera app/hora la pone
     el sistema). Colores de texto por atributo de tema para leerse en fondo claro y oscuro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Fila 1: ejercicio + peso -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/np_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/np_weight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Fila 2: icono de estado + texto + % -->
    <LinearLayout
        android:id="@+id/np_status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/np_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/np_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/np_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Barra de progreso: rosa (subiendo/esperando) o verde (subido) -->
    <ProgressBar
        android:id="@+id/np_bar_pink"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressDrawable="@drawable/np_progress_pink" />

    <ProgressBar
        android:id="@+id/np_bar_green"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="100"
        android:progressDrawable="@drawable/np_progress_green"
        android:visibility="gone" />

    <!-- Mensaje (cancelado / error) -->
    <TextView
        android:id="@+id/np_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Acción (Cancelar / Ver HIT / Aceptar / Ir a HITS guardados) -->
    <TextView
        android:id="@+id/np_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:textColor="#FFD41568"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
