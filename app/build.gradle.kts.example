android {
    namespace = "com.hitbosss"
    compileSdk = 35

    defaultConfig {
        applicationId = "com.hitbosss"
        minSdk = 26          // equivalente práctico a iOS 18 target (cubre el grueso del parque)
        targetSdk = 35
        versionCode = 1
        versionName = "2.1.0"   // >= MINIMUM_VERSION de la API (evita el force-update en dev)
        vectorDrawables { useSupportLibrary = true }
        // El Web client ID de Google lo aporta google-services.json como R.string.default_web_client_id.
    }

    // Un buildType por entorno/conexión de iOS. Todos comparten applicationId "com.hitbosss"
    // (el google-services.json solo registra ese package), así que se reemplazan al instalar.
    // Tarea de instalación entre paréntesis.
    buildTypes {
        // === development · Docker local ===
        debug {
            // localhost de la máquina anfitrión (donde corre `docker compose up`).
            buildConfigField("String", "API_BASE_URL", "API_HOST_DEV"")
            buildConfigField("String", "ENV_NAME", "\"development\"")
        }

        // === development · backend de desarrollo desplegado en Render ===
        create("render") {
            initWith(getByName("debug"))
            signingConfig = signingConfigs.getByName("debug")
            buildConfigField("String", "API_BASE_URL", "API_HOST_RENDER")
            buildConfigField("String", "ENV_NAME", "\"development\"")
            matchingFallbacks += listOf("debug")
        }

        // === testflight/pre · preproducción (debuggable para test interno). (installStaging) ===
        create("staging") {
            initWith(getByName("debug"))
            signingConfig = signingConfigs.getByName("debug")
            buildConfigField("String", "API_BASE_URL", "API_HOST_TESTFLIGHT")
            buildConfigField("String", "ENV_NAME", "\"staging\"")
            matchingFallbacks += listOf("debug")
        }

        // === production · api.hitbosss.com (equivalente App Store; requiere firma release para instalar). (assembleRelease) ===
        release {
            isMinifyEnabled = false
            buildConfigField("String", "API_BASE_URL", "API_HOST_PROD")
            buildConfigField("String", "ENV_NAME", "\"production\"")
            proguardFiles(getDefaultProguardFile("proguard-android-optimize.txt"), "proguard-rules.pro")
        }
    }

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }
    kotlinOptions { jvmTarget = "17" }
    buildFeatures {
        compose = true
        buildConfig = true
    }
}

