# Firma de release para producción / Play Store.
#
# Cómo usarlo:
#   1) Genera el keystore (guárdalo MUY bien: si lo pierdes no podrás actualizar la app en Play Store):
#        keytool -genkey -v -keystore hitbosss-release.jks \
#          -keyalg RSA -keysize 2048 -validity 10000 -alias hitbosss
#   2) Copia este archivo a "keystore.properties" (en la raíz del proyecto) y rellena los valores.
#   3) Vuelve a generar el release: ./gradlew assembleRelease  (APK)  o  ./gradlew bundleRelease  (AAB para Play Store)
#
# Si NO existe keystore.properties, el release se firma con la clave debug (instalable para probar,
# pero NO válido para subir a Play Store).
#
# keystore.properties y los *.jks/*.keystore están en .gitignore: nunca se commitean.

storeFile=hitbosss-release.jks
storePassword=TU_PASSWORD_DEL_KEYSTORE
keyAlias=hitbosss
keyPassword=TU_PASSWORD_DE_LA_CLAVE
